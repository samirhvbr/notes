              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "paths",
          "truncated",
          "next_cursor"
        ],
        "additionalProperties": false
      },
      "Hit": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "context": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "line",
          "context"
