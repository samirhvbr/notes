{
  "openapi": "3.1.0",
  "info": {
    "title": "notes-server REST API",
    "version": "1",
    "description": "One owner. Live notes are path-addressed. The separate sync inbox addresses immutable revisions by UUID and never applies them to live notes. Bearer credentials are operator-provisioned and individually revoked. No cookie sessions or CORS; requests with Origin are refused. HTTP is allowed only on loopback; remote access requires the trusted HTTPS proxy. Text and query limits are measured in UTF-8 bytes. Limits: 8 concurrent requests, 60 requests/minute per credential and 120/minute per connection address. Behind Caddy the connection-address limit is shared. Auditing is bounded to five 10 MiB segments and excludes request content, tokens and note paths."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
