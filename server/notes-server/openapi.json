            "schema": {
              "type": "string"
            }
          }
        }
      },
      "Error500": {
        "description": "Operation failed; consult audit by X-Request-Id",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error503": {
        "description": "Eight-operation ceiling or workspace busy",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
