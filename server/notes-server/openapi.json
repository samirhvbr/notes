          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          },
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Search"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workspaces/{workspace}/sync/revisions": {
      "get": {
        "operationId": "syncRevisions",
        "description": "Read-only incremental metadata inventory, requiring Read. First use creates a private empty inbox UUID. Cursor counts append-log entries, including filtered entries; retain next_cursor even on an empty page. limit bounds scanned entries. Fetch bytes separately. Histories containing any out-of-scope or hidden path are omitted in full. No snapshot isolation, no application acknowledgment and no source files changed. Restart cursor at zero when repairing from an older server backup.",
        "parameters": [
          {
            "name": "workspace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid graph, bytes, cursor or request"
          },
          "401": {
            "description": "Missing or revoked credential"
          },
          "403": {
            "description": "Denied workspace, scope, permission, review mode, Origin or HTTPS peer"
          },
          "404": {
            "description": "Unknown or invisible revision"
          },
          "409": {
            "description": "Workspace or head mismatch, reused UUID, or destination collision"
          },
          "413": {
            "description": "Body exceeds 16 MiB"
          },
          "429": {
            "description": "Rate limit"
          },
          "500": {
            "description": "Invalid, future or unreadable persisted state; never reset"
          },
          "503": {
            "description": "Busy"
          },
          "507": {
            "description": "Inbox capacity reached; nothing evicted"
          }
        }
      },
      "post": {
        "operationId": "publishSyncRevision",
        "description": "Store one revision and its exact bytes atomically. Requires Read plus Create for genesis/resurrection, Update for a live successor, Move for a changed path, Delete for a tombstone. Review writes remain under proposals, including parent paths. Parents must already exist. Head conflicts return 409; the device retains its conflicting revision locally. Exact retries of accepted publication UUIDs succeed without rewinding heads. Response acknowledges inbox storage only, never source application. Limits per workspace: 10,000 revisions, 32 MiB cumulative decoded content and 64 MiB serialized state. No automatic pruning.",
        "parameters": [
          {
            "name": "workspace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncPublication"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "revision",
                    "stored",
                    "applied"
                  ],
                  "properties": {
                    "revision": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "stored": {
                      "const": true
                    },
                    "applied": {
                      "const": false
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid graph, bytes, cursor or request"
          },
          "401": {
            "description": "Missing or revoked credential"
          },
          "403": {
            "description": "Denied workspace, scope, permission, review mode, Origin or HTTPS peer"
          },
          "404": {
            "description": "Unknown or invisible revision"
          },
          "409": {
            "description": "Workspace or head mismatch, reused UUID, or destination collision"
          },
          "413": {
            "description": "Body exceeds 16 MiB"
          },
          "429": {
            "description": "Rate limit"
          },
          "500": {
            "description": "Invalid, future or unreadable persisted state; never reset"
          },
          "503": {
            "description": "Busy"
          },
          "507": {
            "description": "Inbox capacity reached; nothing evicted"
          }
        }
      }
    },
    "/v1/workspaces/{workspace}/sync/revisions/{revision}": {
      "get": {
        "operationId": "fetchSyncRevision",
        "description": "Fetch original bytes for an authorized immutable revision. Requires Read and visibility of the note entire history. UUID knowledge never grants access.",
        "parameters": [
          {
            "name": "workspace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "revision",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncPublication"
                }
              }
            }
          },
          "400": {
            "description": "Invalid graph, bytes, cursor or request"
          },
          "401": {
            "description": "Missing or revoked credential"
          },
          "403": {
            "description": "Denied workspace, scope, permission, review mode, Origin or HTTPS peer"
          },
          "404": {
            "description": "Unknown or invisible revision"
          },
          "409": {
            "description": "Workspace or head mismatch, reused UUID, or destination collision"
          },
          "413": {
            "description": "Body exceeds 16 MiB"
          },
          "429": {
            "description": "Rate limit"
          },
          "500": {
            "description": "Invalid, future or unreadable persisted state; never reset"
          },
          "503": {
            "description": "Busy"
          },
          "507": {
            "description": "Inbox capacity reached; nothing evicted"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "An opaque per-integration credential. Never put it in the URL."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "Create": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Workspace-relative Markdown path; slash-separated."
          },
          "text": {
            "type": "string",
            "maxLength": 8388608
          }
        },
        "required": [
          "path",
          "text"
        ],
        "additionalProperties": false
      },
      "Text": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 8388608,
            "description": "UTF-8 text, at most 8 MiB in bytes; JSON body at most 16 MiB. PATCH appends this text."
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "Move": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      },
      "Note": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "text": {
            "type": [
              "string",
              "null"
            ]
          },
          "read_only": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "path",
          "text",
          "read_only"
        ],
        "additionalProperties": false
      },
      "Write": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "replayed": {
            "type": "boolean"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "Moved": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "links_updated": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "links_updated"
        ],
        "additionalProperties": false
      },
      "Deleted": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "outcome": {
            "enum": [
              "trashed",
              "permanent"
            ]
          }
        },
        "required": [
          "path",
          "outcome"
        ],
        "additionalProperties": false
      },
      "Page": {
        "type": "object",
        "properties": {
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 200
          },
          "truncated": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "paths",
          "truncated",
          "next_cursor"
        ],
        "additionalProperties": false
      },
      "Hit": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "context": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "line",
          "context"
        ],
        "additionalProperties": false
      },
      "Search": {
        "type": "object",
        "properties": {
          "hits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Hit"
            },
            "maxItems": 200
          },
          "truncated": {
            "type": "boolean"
          },
          "mode": {
            "const": "literal"
          },
          "next_cursor": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "hits",
          "truncated",
          "mode",
          "next_cursor"
        ],
        "additionalProperties": false
      },
      "Workspace": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "enum": [
                "read",
                "create",
                "update",
                "move",
                "delete",
                "search"
              ]
            }
          },
          "review": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "scope",
          "permissions",
          "review"
        ],
        "additionalProperties": false
      },
      "Workspaces": {
        "type": "object",
        "properties": {
          "workspaces": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Workspace"
            },
            "maxItems": 1
          }
        },
        "required": [
          "workspaces"
        ],
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "SyncRevision": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "note",
          "parents",
          "device",
          "path",
          "content"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "note": {
            "type": "string",
            "format": "uuid"
          },
          "parents": {
            "type": "array",
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "device": {
            "type": "string",
            "format": "uuid",
            "description": "Client-asserted causal device identity, not an authentication identity."
          },
          "path": {
            "type": "string",
            "maxLength": 4096,
            "description": "Workspace-relative visible Markdown path. Every historical path must remain within the credential scope."
          },
          "content": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^b3:[0-9a-f]{64}$",
            "description": "BLAKE3 of exact original bytes, or null for a tombstone."
          }
        }
      },
      "SyncPublication": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workspace",
          "expected",
          "revision",
          "content_base64"
        ],
        "properties": {
          "workspace": {
            "type": "string",
            "format": "uuid",
            "description": "Inbox UUID returned by the metadata page."
          },
          "expected": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Observed current head, or null for a new note. Mismatch is 409."
          },
          "revision": {
            "$ref": "#/components/schemas/SyncRevision"
          },
          "content_base64": {
            "type": [
              "string",
              "null"
            ],
            "contentEncoding": "base64",
            "maxLength": 11184812,
            "description": "Canonical standard base64 of up to 8 MiB. Null exactly when revision.content is null."
          }
        }
      },
      "SyncPage": {
        "type": "object",
        "required": [
          "workspace",
          "revisions",
          "heads",
          "next_cursor",
          "has_more"
        ],
        "properties": {
          "workspace": {
            "type": "string",
            "format": "uuid"
          },
          "revisions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SyncRevision"
            }
          },
          "heads": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Current heads for notes appearing on this page, possibly later than the page revisions."
          },
          "next_cursor": {
            "type": "integer",
            "minimum": 0
          },
          "has_more": {
            "type": "boolean"
          }
        }
      }
    },
    "responses": {
