{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tura Notes",
  "mainBinaryName": "notes",
  "version": "0.0.0",
  "identifier": "br.com.samirhv.notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tura Notes",
        "width": 1100,
        "height": 720,
        "minWidth": 480,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' notes-asset: data:; font-src 'self'; connect-src ipc: 'self' http://ipc.localhost; frame-src 'none'; object-src 'none'; form-action 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "publisher": "Samir Hanna Verza",
    "homepage": "https://github.com/samirhvbr/tura-notes",
    "license": "MIT",
    "category": "Productivity",
    "shortDescription": "Local-first Markdown notes",
    "longDescription": "Tura Notes edits Markdown files in a folder you choose. The files on disk are the source of truth: no database, no proprietary format, and every note stays readable from a terminal, an editor or a backup with the application uninstalled.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExRTA1RjJGNDhBRjJCRDQKUldUVUs2OUlMMS9nRVJRbTkwNGRXZ05FUWQxUXJRVnk2YWRMZXFKSnFhTU9zdTV6VlFVWnNqbzIK",
      "endpoints": [
        "https://samirhv.com.br/updates/tura-notes/{{target}}-{{arch}}-{{bundle_type}}.json"
      ]
    }
  }
}
